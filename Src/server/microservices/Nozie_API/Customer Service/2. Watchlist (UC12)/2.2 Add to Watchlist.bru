meta {
  name: 2.2 Add to Watchlist
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/customers/{{customerId}}/watchlist
  body: json
  auth: inherit
}

body:json {
  {
    "movieId": "movie-123"
  }
}

vars:pre-request {
  customerId: 1
}

docs {
  Add a movie to customer's watchlist (UC12).
}

settings {
  encodeUrl: true
}
