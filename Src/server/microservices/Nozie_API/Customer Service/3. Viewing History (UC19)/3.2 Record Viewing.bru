meta {
  name: 3.2 Record Viewing
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/customers/{{customerId}}/history
  body: json
  auth: inherit
}

body:json {
  {
    "movieId": "movie-123",
    "progressSeconds": 3600
  }
}

vars:pre-request {
  customerId: 1
}

docs {
  Record a viewing event for customer (UC19).
  progressSeconds: playback position in seconds
}

settings {
  encodeUrl: true
}
