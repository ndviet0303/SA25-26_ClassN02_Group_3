meta {
  name: 3.1 Get Viewing History
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/customers/{{customerId}}/history?limit=50
  body: none
  auth: inherit
}

vars:pre-request {
  customerId: 1
}

docs {
  Get customer's viewing history (UC19).
  Optional query param: limit (default 50)
}

settings {
  encodeUrl: true
}
